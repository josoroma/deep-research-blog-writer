# Offline setup/tests/demos run with these values blank.
# The explicit EPIC-2 live smoke requires a real OPENROUTER_API_KEY.
OPENROUTER_API_KEY=
SEARCH_PROVIDER=serpapi
SERPER_API_KEY=
SERPAPI_API_KEY=
SEARCH_TIMEOUT_SECONDS=15

# Defaults; change an individual agent's model without changing agent code.
MODELS__ORCHESTRATOR=openrouter:deepseek/deepseek-v4.1-flash
MODELS__SEARCH_AGENT=openrouter:deepseek/deepseek-v4.1-flash
MODELS__RESEARCH_AGENT=openrouter:deepseek/deepseek-v4.1-flash
MODELS__ANALYST_AGENT=openrouter:deepseek/deepseek-v4.1-flash
MODELS__WRITER_AGENT=openrouter:deepseek/deepseek-v4.1-flash

PAGES=3
PER_PAGE=10
MAX_URLS=30
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=2
RUNS_DIR=runs
RECURSION_LIMIT=50

# Required only for live fetches. Public URL, mailto address, or email.
CRAWLER_CONTACT=https://github.com/josoroma/deep-research-blog-writer
# fallback = trafilatura -> readability-lxml -> beautifulsoup4; explicit parser selects one.
EXTRACTOR_STRATEGY=fallback

# EPIC-9: tracing is opt-in. Metrics export is off when endpoint is blank.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deep-research-blog-writer
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
OTEL_EXPORTER_OTLP_ENDPOINT=
TELEMETRY_TIMEOUT_SECONDS=3
# For the local Compose stack use: OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
