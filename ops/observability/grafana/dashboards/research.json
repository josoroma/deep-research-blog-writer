{
  "uid": "research-runs",
  "title": "Deep Research Runs",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "5s",
  "timezone": "browser",
  "tags": [
    "research",
    "epic-9"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "run_id",
        "label": "Run",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "research-prometheus"
        },
        "query": "label_values(research_runs_total, run_id)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Runs by status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "research-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (research_runs_total{run_id=~\"$run_id\"})",
          "legendFormat": "{{status}}{{phase}}{{tool}}{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Tokens",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "research-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(research_tokens_total{run_id=~\"$run_id\"})",
          "legendFormat": "{{status}}{{phase}}{{tool}}{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "Cost (USD)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "research-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(research_cost_usd_total{run_id=~\"$run_id\"})",
          "legendFormat": "{{status}}{{phase}}{{tool}}{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "Phase latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "research-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (phase) (research_phase_duration_seconds_sum{run_id=~\"$run_id\"}) / sum by (phase) (research_phase_duration_seconds_count{run_id=~\"$run_id\"})",
          "legendFormat": "{{status}}{{phase}}{{tool}}{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "Tool calls",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "research-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tool) (research_tool_calls_total{run_id=~\"$run_id\"})",
