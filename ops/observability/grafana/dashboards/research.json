        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(research_dangling_citations_total{run_id=~\"$run_id\"})",
          "legendFormat": "{{status}}{{phase}}{{tool}}{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
